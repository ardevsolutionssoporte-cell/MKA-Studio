rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read, write for authenticated users
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders / quotes collection: public create/read, full access for authenticated users
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store settings: public read, write for authenticated users
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
